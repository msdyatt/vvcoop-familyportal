<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" here; Xcode swaps in "production" when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Ties the app to the website so passkeys and saved passwords for family.veritasvillage.org work inside it.
	     The matching file is served at /.well-known/apple-app-site-association (worker/index.ts). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:family.veritasvillage.org</string>
	</array>
	<!-- Apple Pay for dues. The merchant ID is created in the Apple Developer account and linked to Stripe
	     (docs/native-apple-pay-setup.md); this must match APPLE_MERCHANT_ID in lib/dues-api.ts. -->
	<key>com.apple.developer.in-app-payments</key>
	<array>
		<string>merchant.org.veritasvillage.family</string>
	</array>
	<!-- Urgent broadcasts (closures, emergencies) are sent as time-sensitive so they get through Focus modes
	     and the scheduled summary. The App ID needs "Time Sensitive Notifications" enabled in the Apple
	     Developer portal, or a signed build will be rejected (docs/broadcasts.md). -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>
