{
  "version": 1,
  "rules": [
    {
      "patterns": [
        "^/family-village/notifications"
      ],
      "properties": {
        "presentation": "sheet",
        "detent": "large",
        "links": "frame"
      }
    },
    {
      "patterns": [
        "^/family-village/?$"
      ],
      "properties": {
        "presentation": "root",
        "role": "signin"
      }
    },
    {
      "patterns": [
        "^/test-frame/signin"
      ],
      "properties": {
        "presentation": "root",
        "role": "signin"
      }
    },
    {
      "patterns": [
        "^/test-frame/sheet"
      ],
      "properties": {
        "presentation": "sheet",
        "detent": "medium"
      }
    },
    {
      "patterns": [
        "^/test-frame/replace"
      ],
      "properties": {
        "presentation": "replace"
      }
    },
    {
      "patterns": [
        ".*"
      ],
      "properties": {
        "presentation": "push"
      }
    }
  ]
}
